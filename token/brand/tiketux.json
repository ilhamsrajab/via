            "$value": "{border.width.none}",
            "$description": "Brand-standard border thickness for action components such as buttons."
          }
        }
      }
    },
    "form": {
      "field": {
        "default": {
          "brand": {
            "$type": "borderWidth",
            "$value": "{border.width.1}",
            "$description": "Input field border width ensuring visual consistency and brand balance."
          }
        }
      }
    },
    "overlay": {
      "surface": {
        "default": {
          "brand": {
            "$type": "borderWidth",
            "$value": "{border.width.1}",
            "$description": "Thin border for overlays or popups providing subtle definition without distraction."
          }
        }
      }
    }
